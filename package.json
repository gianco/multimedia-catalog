{
  "name": "catalogo-multimediale",
  "version": "0.1.0",
  "description": "Catalogo Multimediale",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:backend": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects backend",
    "test:web": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects web",
    "dev": "tsx watch --env-file-if-exists=.env src/infrastructure/http/main.ts",
    "dev:web": "vite --config web/vite.config.ts web",
    "build:web": "vite build --config web/vite.config.ts web",
    "start": "tsx --env-file-if-exists=.env src/infrastructure/http/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "eslint .",
    "format": "prettier --check \"src/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\" web/vite.config.ts"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
